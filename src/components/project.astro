---
const { name, desc, tags, imgSrc } = Astro.props;

---

<div class="projectCard">
    <div class="projectTags">
        {tags.map((tag: String) => {
            return <p class="projectTag">{tag}</p>;
        })}
    </div>
    <div class="projectImgWrap">
        <!-- <div class="projectImg"></div> -->
        <img class="projectImg" src=`${imgSrc}` alt="Project Clouds Image">
        <div class="projectImgUnderLine"></div>
    </div>
    <p class="projectTitle">{name}</p>
    <p class="projectDesc">{desc}</p>
</div>
