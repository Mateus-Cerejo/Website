---
import '/src/styles/footer.css';

var location = 'Lisbon, Portugal'
var versionTitle = 'Current Website Version'

switch (Astro.currentLocale) {
    case 'pt':
        location = 'Lisboa, Portugal'
        versionTitle = 'Versão Atual do Website'
        break;
    case 'jp':
        location = 'リスボン、ポルトガル'
        versionTitle = 'Current Website Version'
    default:
        break;
}

---
<footer>
    <div id="footer-wrap">
        <a href="mailto:mateuscerejo@proton.me">mateuscerejo@proton.me</a>
        <p>{location}</p>
    </div>
    <a id="version" title={versionTitle} href="https://github.com/Mateus-Cerejo/Website" target="_blank">v1.1.0</a>
</footer>
