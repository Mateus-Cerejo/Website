---
import { getRelativeLocaleUrl } from 'astro:i18n';
import '/src/styles/header.css';

const homeUrl = getRelativeLocaleUrl(Astro.currentLocale!, '/');

const curPath = Astro.url.pathname;
const curLocale = Astro.currentLocale ?? "/";
const pathNoLocale = curPath.replace("/" + curLocale, "");
---

<header>
    <div id="headerWraper">
        <div id="homeButton">
            <div><a href={homeUrl}>HOME</a></div>
        </div>
        <div id="languages">
            <div class="lang"><a id={curLocale == 'pt'? "selectedLang" : ""} href={"/pt" + pathNoLocale}>PT</a> - </div>
            <div class="lang"><a id={curLocale == 'en'? "selectedLang" : ""} href={pathNoLocale}>EN</a> - </div>
            <div class="lang"><a id={curLocale == 'jp'? "selectedLang" : ""} href={"/jp" + pathNoLocale}>JP</a></div>
        </div>
        <div id="contacts">
            <a class="contact" href="https://github.com/Mateus-Cerejo" target="_blank"><img src="/github.svg" alt="github"></a>
            <a class="contact" href="https://www.linkedin.com/in/mateus-cerejo/" target="_blank"><img src="/linkedin.svg" alt="linkedin"></a>
        </div>
    </div>
</header>
