---
import '/src/styles/global.css';
import '/src/styles/projects.css';

import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';
import Project from '../../components/project.astro';


const projects = [
	{
		name: "Personal Website",
		desc: "ここです",
		tags: ["JavaScript", "HTML", "CSS"],
		imgSrc: "/project_website.jpg",
		url: "https://github.com/Mateus-Cerejo/Website"
	},
	{
		name: "CLOUDS",
		desc: "OpenGL & C++ 実験",
		tags: ["OpenGL", "C++"],
		imgSrc: "/project_clouds.png",
		url: "https://github.com/Mateus-Cerejo/Clouds"
	},
	{
		name: "WLTS",
		desc: "デスクトップ向けマルチプレイヤーゲーム",
		tags: ["Unity", "C#", "Blender"],
		imgSrc: "/soon.jpg",
		url: ""
	},
	{
		name: "Boomerang",
		desc: "ワイヤレス分割キーボード",
		tags: ["Kicad", "Orca Slicer"],
		imgSrc: "/project_keyboard.png",
		url: "https://github.com/Mateus-Cerejo/Keyboard-Boomerang"
	}
];

---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		
		<script src="/src/dev/debug.ts"/>
		
		<title>Mateus Cerejo - プロジェクト</title>
	</head>
	<body>
		<Header/>
		<section id="content">
			<p id="pageTitle">プロジェクトと実験</p>
			<div id="galleryWrapper">
				<div id="gallery">
					{projects.map((proj)=>{
						return <Project name={proj.name} desc={proj.desc} tags={proj.tags} imgSrc={proj.imgSrc} url={proj.url}></Project>;
					})}
				</div>
			</div>
		</section>
		<Footer/>
	</body>
</html>
