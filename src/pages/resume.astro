---
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';

import '/src/styles/global.css';
import '/src/styles/resume.css'
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		
		<script src="/src/dev/debug.ts"/>

		<title>Mateus Cerejo - Resume</title>
	</head>
	<body>
		<Header/>
		<section id="content">
			<p id="pageTitle">Curriculum Vitae</p>
            <div id="downloadSection">
                <p>PDF VERSION</p>
                <img id="downloadPDFBtn" src="/download.svg" alt="download">
            </div>
            <div id="listResume">
                <div id="listLeft">
                    <div id="cvCategoryEducation">
                        <p class="cvCategoryTitle">Education</p>
                        <div class="degree">
                            <p class="degreeTitle">Bachelor's Degree - Software Engineering</p>
                            <p class="degreeSchoolName">Instituto Politécnico de Setubal</p>
                            <p class="degreeDates">2021-2024</p>
                            <p class="degreeGrade">ECTS grade - B</p>
                        </div>
                    </div>
                    <div id="cvCategorySkills">
                        <p class="cvCategoryTitle">Relevant Skills</p>
                        <div id="skillsList">
                            <p>OOP - Java, C++, C#, JavaScript, TypeScript</p>
                            <p>Web / UI Frameworks - React, Astro, Flutter</p>
                            <p>Graphics programming - OpenGL, GLSL</p>
                            <p>Automation / Scripting - Python, bash</p>
                            <p>Game Development - Unity, Blender, Gimp</p>
                            <p>Project Management - Jira, Confluence, Trello, GitHub / Bitbucket</p>
                            <p>Other - Git, C, Linux, Figma, Common Lisp, Astro</p>
                        </div>
                    </div>
                    <div id="cvCategoryCertifications">
                        <p class="cvCategoryTitle">Certifications</p>
                        <div class="certification">
                            <p>Computer Graphics With Modern OpenGL - 2026</p>
                            <p>Udemy</p>
                            <p>Grade: N/A</p>
                        </div>
                        <div class="certification">
                            <p>Advanced English C1 - 2026</p>
                            <p>Cambridge</p>
                            <p>Grade: A</p>
                        </div>
                    </div>
                    <div id="cvCategoryLanguages">
                        <p class="cvCategoryTitle">Languages</p>
                        <p>Português - Fluent</p>
                        <p>English - Proficient</p>
                        <p>日本語 - Basic</p>
                    </div>
                </div>
                <div id="listRight">
                    <div id="cvCategoryWork">
                        <p class="cvCategoryTitle">Work Experience</p>
                    </div>
                    <div id="cvCategoryProjects">
                        <p class="cvCategoryTitle">Projects</p>
                    </div>
                </div>
            </div>
		</section>
		<Footer/>
	</body>
</html>