---
import Header from '../components/header.astro';
import '/src/styles/global.css';
import '/src/styles/index.css';
// import '/src/styles/debug.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		
		<script src="/src/dev/debug.ts"/>

		<title>Mateus Cerejo - Portfolio</title>
	</head>
	<body>
		<Header/>
		<section id="content">
			<div id="intro">
				<div id="intro-left">
					<img class="avatar" src="/avatar-low-rez.jpg" alt="Avatar">
					<a id="about" href="/about">About</a>
				</div>
				<div id="intro-right">
					<p id="intro-name">Mateus Cerejo</p>
					<p id="intro-slogan">Software Engineer</p>
				</div>
			</div>
			<div id="navigation">
				<!-- TODO wrap with div to make clickable zone smaller -->
				<a id="about-link" href="/about">About</a>
				<a href="/projects">Projects</a>
				<a href="/cv">Curriculum Vitae</a>
				<a href="/contact">Contact</a>
			</div>
		</section>
		<footer>
			<div id="footer-wrap">
				<!-- <p>
					Contact: <a href="mailto:mateussoftware@proton.me">mateussoftware@proton.me</a>
				</p> -->
				<p>Lisbon, Portugal</p>
			</div>
			<a id="version" href="https://github.com/Mateus-Cerejo/Website" target="_blank">v0.1.0</a>
		</footer>
	</body>
</html>
