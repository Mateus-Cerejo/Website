---
<html lang="pt">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		
		<script src="/src/dev/debug.ts"/>

		<title>Mateus Cerejo - Currículo</title>
	</head>
	<body>
		<Header/>
		<section id="content">
			<p id="pageTitle">Curriculum Vitae</p>
            <div id="requestPDFSection" title="Requerimento do CV em PDF">
                <a href="mailto:mateuscerejo@proton.me?subject=Requerimento%20do%20CV%20em%20pdf">VERSÃO PDF<img id="requestPDFBtn" src="/email.svg" alt="Requerimento do CV em PDF"></a>
            </div>
            <div id="flexResume">
                <div id="listLeft">
                    <div id="cvCategoryEducation">
                        <p class="cvCategoryTitle">Educação</p>
                        {resume.education.degrees.map((degree)=>
                            <div class="degree">
                                <p class="degreeTitle">{degree.title}</p>
                                <p class="degreeSchoolName">{degree.entity}</p>
                                <p class="degreeDates">{degree.date}</p>
                                <p class="degreeGrade">{degree.grade} <a href="https://en.wikipedia.org/wiki/ECTS_grading_scale" target="_blank" title="European Credit Transfer and Accumulation System"><img class="infoImg" src="/info.svg" alt="Nota ECTS"/></a></p>
                            </div>
                        )}
                    </div>
                    <div id="cvCategorySkills">
                        <p class="cvCategoryTitle">Skills Relevantes</p>
                        <div id="skillsList">
                            {resume.skillList.map((skillCatg)=>{
                                if (skillCatg.title == "OOP") {
                                    return <li class="skills" title="Object Oriented Programming"><span>{skillCatg.title}</span> - {skillCatg.skills.join(', ')}</li>   
                                }
                                return <li class="skills"><span>{skillCatg.title}</span> - {skillCatg.skills.join(', ')}</li>
                            })}
                        </div>
                    </div>
                    <div id="cvCategoryCertifications">
                        <p class="cvCategoryTitle">Certificações</p>
                        {resume.certifications.map((cert)=>
                            <div class="certification">
                                <p class="certTitle">{cert.title}, <span>{cert.entity}</span></p>
                                <p class="certDate">{cert.date}</p>
                            </div>
                        )}
                    </div>
                </div>
                <div id="listRight">
                    <div id="cvCategoryWork">
                        <p class="cvCategoryTitle">Experiência de Trabalho</p>
                        {resume.workExperience.jobs.map((job)=>
                            <div class="job">
                                <p class="jobTitle">{job.title}<span> - {job.date}</span></p>
                                <p class="jobEntity" title="Faz um requerimento da versão pdf para veres onde trabalhei">{job.entity}</p>
                                <p></p>
                                <ul>
                                    {job.tasks.map((task)=>
                                        <li class="jobTask">{task}</li>
                                    )}
                                </ul>
                            </div>
                        )}
                    </div>
                    <!-- <div id="cvCategoryProjects">
                        <p class="cvCategoryTitle">Projects</p>
                        {resume.projects.map((proj)=>
                            <p class="cvProject" title={proj.tooltip}><span>{proj.title}</span> - {proj.type}</p>
                        )}
                    </div> -->
                    <div id="cvCategoryLanguages">
                        <p class="cvCategoryTitle">Idiomas</p>
                        {resume.languages.map((lang)=>
                            <p class="cvLanguage" title={lang.otherNames}><span>{lang.name}</span> - {lang.level}</p>
                        )}
                    </div>
                </div>
            </div>
            <div id="listResume">
                <div id="cvCategoryEducation">
                    <p class="cvCategoryTitle">Educação</p>
                    {resume.education.degrees.map((degree)=>
                        <div class="degree">
                            <p class="degreeTitle">{degree.title}</p>
                            <p class="degreeSchoolName">{degree.entity}</p>
                            <p class="degreeDates">{degree.date}</p>
                            <p class="degreeGrade">{degree.grade} <a href="https://en.wikipedia.org/wiki/ECTS_grading_scale" target="_blank" title="European Credit Transfer and Accumulation System"><img class="infoImg" src="/info.svg" alt="Nota ECTS"/></a></p>
                        </div>
                    )}
                </div>
                <div id="cvCategoryWork">
                    <p class="cvCategoryTitle">Experiência de Trabalho</p>
                    {resume.workExperience.jobs.map((job)=>
                        <div class="job">
                            <p class="jobTitle">{job.title}</p>
                            <p class="jobEntity" title="Faz um requerimento da versão pdf para veres onde trabalhei">{job.entity}</p>
                            <p class="jobDate">{job.date}</p>
                            <p></p>
                            <ul>
                                {job.tasks.map((task)=>
                                    <li class="jobTask">{task}</li>
                                )}
                            </ul>
                        </div>
                    )}
                </div>
                <div id="cvCategorySkills">
                    <p class="cvCategoryTitle">Skills Relevantes</p>
                    <div id="skillsList">
                        {resume.skillList.map((skillCatg)=>{
                            if (skillCatg.title == "OOP") {
                                return <li class="skills" title="Object Oriented Programming"><span>{skillCatg.title}</span> - {skillCatg.skills.join(', ')}</li>   
                            }
                            return <li class="skills"><span>{skillCatg.title}</span> - {skillCatg.skills.join(', ')}</li>
                        })}
                    </div>
                </div>
                <div id="cvCategoryCertifications">
                    <p class="cvCategoryTitle">Certificações</p>
                    {resume.certifications.map((cert)=>
                        <div class="certification">
                            <p class="certTitle">{cert.title}, <span>{cert.entity}</span></p>
                            <p class="certDate">{cert.date}</p>
                        </div>
                    )}
                </div>
                <!-- <div id="cvCategoryProjects">
                    <p class="cvCategoryTitle">Projects</p>
                    {resume.projects.map((proj)=>
                        <p class="cvProject" title={proj.tooltip}><span>{proj.title}</span> - {proj.type}</p>
                    )}
                </div> -->
                <div id="cvCategoryLanguages">
                    <p class="cvCategoryTitle">Idiomas</p>
                    {resume.languages.map((lang)=>
                        <p class="cvLanguage" title={lang.otherNames}><span>{lang.name}</span> - {lang.level}</p>
                    )}
                </div>
            </div>
		</section>
		<Footer/>
	</body>
</html>